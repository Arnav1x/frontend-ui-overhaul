# Required when AI Authoring is implemented in M05.
OPENAI_API_KEY=

# Bounded Browser Execution Agent model/browser-command call limit per task.
TESTGEN_AI_AUTHORING_MODEL=gpt-5.6-terra
TESTGEN_AI_AUTHORING_CALL_LIMIT=100 #longer tests require longer limits

# Required by the deterministic NCRMS STD Log in button. Loaded in Electron's
# main process only and never exposed to the renderer.
NCRMS_STD_USERNAME=
NCRMS_STD_PASSWORD=

